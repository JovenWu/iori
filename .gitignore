# Git Bash redirects (`-o nul`, `> nul`) bypass Windows' reserved-name check
# and create a real `nul` file, which bind-mounts into containers as a
# broken char device. `frontend/nul/` exists as a directory on purpose —
# it blocks the file from being created. Do not delete it.
nul

# App artifacts
uploads/
*.log

# Local chart playground (not part of the app)
frontend/app/chart-gallery/

# Local agent working state
.superpowers/
