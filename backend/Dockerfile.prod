# Backend production image — baked source, no bind mount, no --reload,
# non-root user, runtime deps only (pytest stays in the dev image).
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN addgroup --system app && adduser --system --ingroup app app \
    && chown -R app:app /app
USER app

EXPOSE 8000

# Migrate, then serve. Single worker only — detached runs, the SSE replay
# registry, and the scheduler loop are all in-process state; scaling out
# needs sticky sessions + a separated scheduler, not more workers.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
