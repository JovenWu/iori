# ── Environment ──
# "production" enables fail-closed startup checks (strong secret required) and
# hides API docs.
ENVIRONMENT=development

# ── Database (Docker Compose Postgres + pgvector) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sectors_agent
POSTGRES_HOST=localhost
# Host port for the compose container — 5433 avoids clashing with a local Postgres.
POSTGRES_PORT=5433

# ── Auth / JWT ──
# Generate: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ── App account (login-only, no registration) ──
APP_USERNAME=demo
APP_PASSWORD=demo123

# ── LLM: OpenRouter (chat, classification, embeddings) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=sectors-agent
MODEL_NAME=openai/gpt-5.6-luna
CLASSIFIER_MODEL=openai/gpt-5.6-luna
# Reasoning effort for the agent model; empty = plain chat completions.
MODEL_REASONING_EFFORT=high
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=5

# ── TypeSafe JEV (classification: routing, retrieval gates, rerank) ──
# Unset = all JEV call sites fall back to LLM/deterministic behavior.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ── Sectors API (IDX market data) ──
# Unset = sectors_* tools report "not configured" instead of calling upstream.
SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_TIMEOUT=20
# EOD data publishes after the IDX close; EOD cache entries go stale at the
# next weekday occurrence of this hour (Asia/Jakarta).
SECTORS_REFRESH_HOUR_WIB=17
SECTORS_CACHE_STATIC_DAYS=7
SECTORS_CACHE_NEWS_MINUTES=30
SECTORS_TOOL_MAX_CHARS=12000

# ── Context management ──
CONTEXT_TOKEN_LIMIT=16000
KEEP_TURNS=2
THREAD_TITLE_MAX_CHARS=80

# ── Long-term memory retrieval ──
MEMORY_RETRIEVAL_THRESHOLD=0.15
MEMORY_RETRIEVAL_CANDIDATES=20
MEMORY_TOP_K=5
MEMORY_BM25_CANDIDATES=20
MEMORY_RRF_K=60
MEMORY_RERANK_THRESHOLD=0.5
MEMORY_MAX_PER_USER=200
MEMORY_BACKGROUND_CONCURRENCY=4
MEMORY_VECTOR_FLOOR=0.6

# ── Cross-thread recall ──
THREAD_DIGEST_STALE_TURNS=3
THREAD_DIGEST_MAX_CHARS=1500
THREAD_SIGNAL_TOP_K=3
THREAD_RECALL_CANDIDATES=20
THREAD_RECALL_BM25_CANDIDATES=20
THREAD_RECALL_RRF_K=60
THREAD_RECALL_THRESHOLD=0.15

# ── Streaming / checkpoints ──
# CHECKPOINTER_POOL_MAX_SIZE must stay greater than STREAM_MAX_ACTIVE_RUNS.
STREAM_MAX_ACTIVE_RUNS=20
STREAM_MAX_ACTIVE_RUNS_PER_USER=5
STREAM_RUN_BUFFER_MAX=4000
STREAM_RUN_LINGER_SECONDS=45
CHECKPOINTER_POOL_MAX_SIZE=25

# ── API ──
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
MAX_JSON_BODY_BYTES=262144
